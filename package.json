{
  "name": "strobe-assistant",
  "version": "1.0.0",
  "private": true,
  "description": "ACP web client and Amazon Bedrock agent for Strobe photo search.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc --noEmit",
    "build:server": "esbuild server/strobe-agent.ts --bundle --platform=node --target=node22 --format=cjs --outfile=build/strobe-agent.cjs",
    "preview": "vite preview",
    "server": "tsx server/strobe-agent.ts",
    "server:deterministic": "tsx server/deterministic-acp.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@aws-sdk/client-bedrock-runtime": "3.901.0",
    "@aws-sdk/client-secrets-manager": "3.901.0",
    "dompurify": "3.4.14",
    "marked": "16.1.2",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "@types/ws": "8.18.1",
    "vite": "8.2.2",
    "tsx": "4.20.3",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
